{
  "name": "opencode-chromium",
  "version": "1.5.0",
  "description": "Provider-neutral Chromium browser automation for MCP, OpenCode V2, Codex, and direct JavaScript agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quindart-com/opencode-chromium-browser-plugin.git"
  },
  "homepage": "https://github.com/Quindart-com/opencode-chromium-browser-plugin#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "keywords": [
    "browser-automation",
    "chromium",
    "mcp",
    "opencode",
    "codex",
    "ai-agent",
    "native-messaging"
  ],
  "files": [
    "dist",
    "extension",
    "native-host/src",
    "native-host/README.md",
    "skills",
    "docs",
    "scripts/README.md",
    "scripts/analyze-browser-sessions.js",
    "scripts/benchmark-search.js",
    "scripts/build.js",
    "scripts/check-extension-installed.js",
    "scripts/check-mcp.js",
    "scripts/check-native-host.js",
    "scripts/check-opencode.js",
    "scripts/check-schema-budget.js",
    "scripts/schema-budget.js",
    "scripts/chrome-is-running.js",
    "scripts/find-extension-id.js",
    "scripts/install-native-host.js",
    "scripts/installed-browsers.js",
    "scripts/open-browser-window.js",
    "scripts/pack.js",
    "scripts/package-check.js",
    "scripts/public-hygiene.js",
    "scripts/release-check.js",
    "scripts/schema-report.js",
    "scripts/local-client-report.js",
    "scripts/parity-report.js",
    "scripts/test-tarball.js",
    "scripts/check-tag-version.js",
    "assets",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": "./dist/adapters/opencode/index.js",
    "./core": "./dist/core/index.js",
    "./mcp": "./dist/adapters/mcp/server.js",
    "./sdk": "./dist/adapters/sdk/index.js",
    "./browser": "./dist/browser/operations/index.js",
    "./versions": "./dist/core/versions.js"
  },
  "bin": {
    "opencode-chromium": "./dist/cli/index.js",
    "opencode-chromium-mcp": "./dist/adapters/mcp/server.js",
    "opencode-browser-plugin": "./dist/cli/index.js",
    "opencode-browser-plugin-mcp": "./dist/adapters/mcp/server.js"
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "clean": "bun scripts/build.js --clean",
    "host": "bun native-host/src/host.js",
    "mcp": "bun src/adapters/mcp/server.js",
    "mcp:http": "bun src/adapters/mcp/server.js --transport=http",
    "agent:server": "bun src/adapters/mcp/server.js",
    "agent:http": "bun src/adapters/mcp/server.js --transport=http",
    "codex:server": "bun src/adapters/mcp/server.js",
    "check": "bun run check:schemas && bun run check:package && bun run check:mcp && bun run check:public-hygiene && bun run adapter:report && bun test",
    "check:mcp": "bun scripts/check-mcp.js",
    "check:schemas": "bun scripts/check-schema-budget.js",
    "check:package": "bun scripts/package-check.js",
    "check:public-hygiene": "bun scripts/public-hygiene.js",
    "check:release": "bun scripts/release-check.js",
    "check:release-hygiene": "bun scripts/release-check.js --hygiene-only",
    "check:tag": "bun scripts/check-tag-version.js",
    "test": "bun test",
    "test:contracts": "bun test tests/contracts tests/adapters",
    "test:mcp": "bun scripts/check-mcp.js",
    "test:opencode": "bun scripts/check-opencode.js",
    "test:codex": "bun scripts/check-mcp.js",
    "test:tarball": "bun scripts/test-tarball.js",
    "pack": "bun scripts/pack.js",
    "schema:report": "bun scripts/schema-report.js",
    "schema:budget": "bun scripts/schema-budget.js",
    "client:report": "bun scripts/local-client-report.js",
    "adapter:report": "bun scripts/parity-report.js",
    "install:native-host": "bun scripts/install-native-host.js",
    "check:native-host": "bun scripts/check-native-host.js",
    "check:extension": "bun scripts/check-extension-installed.js --json",
    "check:browser-running": "bun scripts/chrome-is-running.js --check --json",
    "list:browsers": "bun scripts/installed-browsers.js --json",
    "open:browser": "bun scripts/open-browser-window.js",
    "find:extension": "bun scripts/find-extension-id.js",
    "doctor": "bun src/cli/index.js doctor",
    "verify": "bun src/cli/index.js verify"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/node": "2.0.0-beta.4",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@opencode-ai/plugin": "1.18.11",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
