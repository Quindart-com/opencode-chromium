{
  "name": "opencode-chromium",
  "version": "1.9.1",
  "description": "Provider-neutral Chromium and Firefox browser automation for MCP, OpenCode V2, Codex, and direct JavaScript agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quindart-com/opencode-chromium.git"
  },
  "homepage": "https://github.com/Quindart-com/opencode-chromium#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "keywords": [
    "browser-automation",
    "chromium",
    "firefox",
    "mcp",
    "opencode",
    "codex",
    "ai-agent",
    "native-messaging"
  ],
  "files": [
    "dist",
    "native-host/dist",
    "extension",
    "extension-firefox",
    "skills",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/adapters/opencode/index.d.ts",
      "import": "./dist/adapters/opencode/index.js",
      "default": "./dist/adapters/opencode/index.js"
    },
    "./server": {
      "types": "./dist/adapters/opencode/index.d.ts",
      "import": "./dist/adapters/opencode/index.js",
      "default": "./dist/adapters/opencode/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./mcp": {
      "types": "./dist/adapters/mcp/server.d.ts",
      "import": "./dist/adapters/mcp/server.js",
      "default": "./dist/adapters/mcp/server.js"
    },
    "./sdk": {
      "types": "./dist/adapters/sdk/index.d.ts",
      "import": "./dist/adapters/sdk/index.js",
      "default": "./dist/adapters/sdk/index.js"
    },
    "./browser": {
      "types": "./dist/browser/operations/index.d.ts",
      "import": "./dist/browser/operations/index.js",
      "default": "./dist/browser/operations/index.js"
    },
    "./versions": {
      "types": "./dist/core/versions.d.ts",
      "import": "./dist/core/versions.js",
      "default": "./dist/core/versions.js"
    }
  },
  "bin": {
    "opencode-chromium": "./dist/cli/index.js",
    "opencode-chromium-mcp": "./dist/adapters/mcp/server.js",
    "opencode-browser-plugin": "./dist/cli/index.js",
    "opencode-browser-plugin-mcp": "./dist/adapters/mcp/server.js"
  },
  "scripts": {
    "prepare": "node -e \"try{require('node:fs').accessSync('.git');require('node:child_process').execSync('git config core.hooksPath .githooks')}catch{}\"",
    "build": "bun scripts/build.js",
    "clean": "bun scripts/build.js --clean",
    "host": "bun native-host/src/host.js",
    "mcp": "bun src/adapters/mcp/server.js",
    "mcp:http": "bun src/adapters/mcp/server.js --transport=http",
    "agent:server": "bun src/adapters/mcp/server.js",
    "agent:http": "bun src/adapters/mcp/server.js --transport=http",
    "codex:server": "bun src/adapters/mcp/server.js",
    "check": "bun run typecheck:backend && bun run lint && bun run check:unused && bun run check:architecture && bun run check:schemas && bun run check:package && bun run check:mcp && bun run adapter:report && bun test",
    "check:architecture": "bun scripts/check-architecture.js",
    "check:mcp": "bun scripts/check-mcp.js",
    "check:schemas": "bun scripts/check-schema-budget.js",
    "check:package": "bun scripts/package-check.js",
    "check:release": "bun scripts/release-check.js",
    "check:tag": "bun scripts/check-tag-version.js",
    "check:version-bump": "bun scripts/check-version-bump.js",
    "test": "bun test",
    "test:contracts": "bun test tests/contracts tests/adapters",
    "test:mcp": "bun scripts/check-mcp.js",
    "test:opencode": "bun scripts/check-opencode.js",
    "test:codex": "bun scripts/check-mcp.js",
    "test:tarball": "bun scripts/test-tarball.js",
    "pack": "bun scripts/pack.js",
    "schema:report": "bun scripts/schema-report.js",
    "schema:budget": "bun scripts/schema-budget.js",
    "client:report": "bun scripts/local-client-report.js",
    "adapter:report": "bun scripts/parity-report.js",
    "extension:prepare": "wxt prepare",
    "extension:dev": "wxt",
    "build:extension": "wxt build",
    "build:extension:firefox": "wxt build -b firefox --mv3",
    "zip:extension:firefox": "bun run build:extension:firefox && bun scripts/build-extension-zip.js --firefox",
    "check:firefox": "bun scripts/firefox-safety-check.js",
    "firefox:submit": "bun scripts/firefox-submit.js",
    "typecheck:extension": "wxt prepare && tsc --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "zip:extension": "bun run build:extension && bun scripts/build-extension-zip.js",
    "check:webstore": "bun scripts/webstore-safety-check.js",
    "webstore:submit": "bun scripts/webstore-submit.js",
    "install:native-host": "bun scripts/install-native-host.js",
    "check:native-host": "bun scripts/check-native-host.js",
    "check:extension": "bun scripts/check-extension-installed.js --json",
    "check:browser-running": "bun scripts/chrome-is-running.js --check --json",
    "list:browsers": "bun scripts/installed-browsers.js --json",
    "open:browser": "bun scripts/open-browser-window.js",
    "find:extension": "bun scripts/find-extension-id.js",
    "doctor": "bun src/cli/index.js doctor",
    "link": "bun src/cli/index.js link",
    "status": "bun src/cli/index.js status",
    "sync": "bun src/cli/index.js sync",
    "verify": "bun src/cli/index.js verify",
    "verify:popup": "node scripts/verify-popup.js",
    "verify:uploads": "node scripts/verify-uploads.js",
    "verify:cursor": "node scripts/verify-cursor.js",
    "lint": "eslint src/management src/cli/providers.ts native-host/src/decisions extension-src/entrypoints/popup/ProviderSettings.tsx",
    "check:unused": "knip --no-progress --include files,dependencies",
    "benchmark:decisions": "bun scripts/benchmark-decision-pipeline.ts",
    "benchmark:flow": "bun scripts/benchmark-agent-flow.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@opencode-ai/plugin": "1.18.34",
    "effect": "3.22.1",
    "jsonc-parser": "^3.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.9.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "playwright": "1.63.0",
    "publish-browser-extension": "6.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4",
    "yazl": "3.3.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "protobufjs": "7.6.5"
  }
}
