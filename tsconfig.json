{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "extension-src/**/*.ts",
    "extension-src/**/*.tsx",
    ".wxt/**/*.d.ts",
    "wxt.config.ts"
  ]
}
